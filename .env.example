# Variables de Entorno - Ejemplo
# Copia este archivo a .env y cambia los valores

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=myapp
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword

# phpMyAdmin
PMA_HOST=mysql
PMA_USER=root
PMA_PORT=3306

# Puertos
MYSQL_PORT=3306
APACHE_PORT=8000
PHPMYADMIN_PORT=8080

# Otros
PROJECT_NAME=docker-proyecto
ENV=development
